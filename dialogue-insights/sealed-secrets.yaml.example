# Генерация sealed secrets (выполнить когда кластер доступен).
#
# Пароли БД. Те же значения попадут в строки подключения ниже, поэтому
# сгенерируй их один раз и подставляй везде одинаково:
#
#   IDENTITY_PASSWORD=$(openssl rand -hex 24)
#   TELEGRAM_PASSWORD=$(openssl rand -hex 24)
#   CONVERSATION_PASSWORD=$(openssl rand -hex 24)
#
# kubectl create secret generic dialogue-identity-credentials \
#   --namespace dialogue-insights \
#   --from-literal=username=identity \
#   --from-literal=password=$IDENTITY_PASSWORD \
#   --dry-run=client -o yaml | kubeseal -o yaml > dialogue-insights/sealed-secrets.yaml
#
# kubectl create secret generic dialogue-telegram-credentials \
#   --namespace dialogue-insights \
#   --from-literal=username=telegram \
#   --from-literal=password=$TELEGRAM_PASSWORD \
#   --dry-run=client -o yaml | kubeseal --merge-into dialogue-insights/sealed-secrets.yaml
#
# kubectl create secret generic dialogue-conversation-credentials \
#   --namespace dialogue-insights \
#   --from-literal=username=conversation \
#   --from-literal=password=$CONVERSATION_PASSWORD \
#   --dry-run=client -o yaml | kubeseal --merge-into dialogue-insights/sealed-secrets.yaml
#
# Строки подключения, которые читают сами сервисы. Хост postgres-rw даёт
# CNPG-кластер из postgres.yaml.
#
# kubectl create secret generic identity-secrets \
#   --namespace dialogue-insights \
#   --from-literal=database-url="postgres://identity:$IDENTITY_PASSWORD@postgres-rw:5432/identity" \
#   --dry-run=client -o yaml | kubeseal --merge-into dialogue-insights/sealed-secrets.yaml
#
# kubectl create secret generic conversation-secrets \
#   --namespace dialogue-insights \
#   --from-literal=database-url="postgres://conversation:$CONVERSATION_PASSWORD@postgres-rw:5432/conversation" \
#   --dry-run=client -o yaml | kubeseal --merge-into dialogue-insights/sealed-secrets.yaml
#
# Telegram: api-id и api-hash с my.telegram.org/apps, session-master-key -
# любые 32+ случайных байта, им шифруются локальные базы TDLib.
#
# kubectl create secret generic telegram-connector-secrets \
#   --namespace dialogue-insights \
#   --from-literal=database-url="postgres://telegram:$TELEGRAM_PASSWORD@postgres-rw:5432/telegram" \
#   --from-literal=api-id=<TELEGRAM_API_ID> \
#   --from-literal=api-hash=<TELEGRAM_API_HASH> \
#   --from-literal=session-master-key=$(openssl rand -hex 32) \
#   --dry-run=client -o yaml | kubeseal --merge-into dialogue-insights/sealed-secrets.yaml
#
# Доступ к приватному GHCR. Токену достаточно read:packages.
#
# kubectl create secret docker-registry ghcr-secret \
#   --namespace dialogue-insights \
#   --docker-server=ghcr.io \
#   --docker-username=jaennil \
#   --docker-password=<GITHUB_TOKEN> \
#   --dry-run=client -o yaml | kubeseal --merge-into dialogue-insights/sealed-secrets.yaml
